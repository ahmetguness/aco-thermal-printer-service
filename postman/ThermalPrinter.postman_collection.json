{
  "info": {
    "_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
    "name": "ACO Thermal Printer Service",
    "description": "Ready-to-use Postman collection for testing the thermal printer service API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": "test-token-1234"
    },
    {
      "key": "failedJobId",
      "value": "replace-with-failed-job-id"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Connect USB",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"usb\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/connect",
          "host": ["{{baseUrl}}"],
          "path": ["connect"]
        }
      }
    },
    {
      "name": "Connect LAN",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"lan\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/connect",
          "host": ["{{baseUrl}}"],
          "path": ["connect"]
        }
      }
    },
    {
      "name": "Status",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/status",
          "host": ["{{baseUrl}}"],
          "path": ["status"]
        }
      }
    },
    {
      "name": "Print Text",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Merhaba ACO\",\n  \"language\": \"tr\",\n  \"idempotencyKey\": \"text-demo-001\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/print/text",
          "host": ["{{baseUrl}}"],
          "path": ["print", "text"]
        }
      }
    },
    {
      "name": "Print QR",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"data\": \"ACO|ACO-TEST-0001-0001|2025-09-16T16:19:02.000Z|3.00|TRY\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/print/qr",
          "host": ["{{baseUrl}}"],
          "path": ["print", "qr"]
        }
      }
    },
    {
      "name": "Print Image",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"imageBase64\": \"BASE64_IMAGE_DATA\",\n  \"filename\": \"receipt.png\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/print/image",
          "host": ["{{baseUrl}}"],
          "path": ["print", "image"]
        }
      }
    },
    {
      "name": "Print ACO Receipt",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"machineId\": \"ACO-TEST-0001-0001\",\n  \"rewardName\": \"Aco Recycling Default Reward\",\n  \"currency\": \"TRY\",\n  \"issuedAt\": \"2025-09-16T16:19:02.000Z\",\n  \"items\": [\n    { \"product\": \"Glass\", \"quantity\": 0, \"reward\": 0 },\n    { \"product\": \"Plastic\", \"quantity\": 2, \"reward\": 2 },\n    { \"product\": \"Metal\", \"quantity\": 1, \"reward\": 1 },\n    { \"product\": \"Tetrapak\", \"quantity\": 0, \"reward\": 0 }\n  ],\n  \"qrPayload\": \"ACO|ACO-TEST-0001-0001|2025-09-16T16:19:02.000Z|3.00|TRY\",\n  \"language\": \"tr\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/print/receipt",
          "host": ["{{baseUrl}}"],
          "path": ["print", "receipt"]
        }
      }
    },
    {
