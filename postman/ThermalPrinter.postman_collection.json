        "body": {
          "mode": "raw",
          "raw": "{\n  \"paper\": \"out\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/mock/health",
          "host": ["{{baseUrl}}"],
          "path": ["mock", "health"]
