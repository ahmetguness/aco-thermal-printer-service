        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paper\": \"ok\",\n  \"cover\": \"closed\",\n  \"temperature\": \"normal\"\n}",
          "options": { "raw": { "language": "json" } }
