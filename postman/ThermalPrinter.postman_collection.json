    },
    {
      "name": "Simulate Paper Jam",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res && res.data && res.data.id) {",
              "  pm.collectionVariables.set('failedJobId', res.data.id);",
              "  console.log('failedJobId set to:', res.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Paper jam simulation\",\n  \"simulateError\": \"PAPER_JAM\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/print/text",
          "host": ["{{baseUrl}}"],
          "path": ["print", "text"]
        }
      }
    },
    {
      "name": "Simulate Unknown Command",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res && res.data && res.data.id) {",
              "  pm.collectionVariables.set('failedJobId', res.data.id);",
              "  console.log('failedJobId set to:', res.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Unknown command simulation\",\n  \"simulateError\": \"UNKNOWN_COMMAND\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/print/text",
          "host": ["{{baseUrl}}"],
          "path": ["print", "text"]
        }
      }
    },
    {
