{
  "info": {
    "name": "ACO Thermal Printer Service",
    "description": "Ready-to-use Postman collection for testing the thermal printer service API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": "test-token-1234"
    },
    {
      "key": "failedJobId",
      "value": "replace-with-failed-job-id"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Connect USB",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"usb\"\n}"
        },
        "url": "{{baseUrl}}/connect"
      }
    },
    {
      "name": "Connect LAN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mode\": \"lan\"\n}"
        },
        "url": "{{baseUrl}}/connect"
      }
    },
    {
      "name": "Status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/status"
      }
    },
    {
      "name": "Print Text",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Merhaba ACO\",\n  \"language\": \"tr\",\n  \"idempotencyKey\": \"text-demo-001\"\n}"
        },
        "url": "{{baseUrl}}/print/text"
      }
    },
    {
      "name": "Print QR",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"data\": \"ACO|ACO-TEST-0001-0001|2025-09-16T16:19:02.000Z|3.00|TRY\"\n}"
        },
        "url": "{{baseUrl}}/print/qr"
      }
    },
    {
      "name": "Print Image",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"imageBase64\": \"BASE64_IMAGE_DATA\",\n  \"filename\": \"receipt.png\"\n}"
        },
        "url": "{{baseUrl}}/print/image"
      }
    },
    {
      "name": "Print ACO Receipt",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"machineId\": \"ACO-TEST-0001-0001\",\n  \"rewardName\": \"Aco Recycling Default Reward\",\n  \"currency\": \"TRY\",\n  \"issuedAt\": \"2025-09-16T16:19:02.000Z\",\n  \"items\": [\n    { \"product\": \"Glass\", \"quantity\": 0, \"reward\": 0 },\n    { \"product\": \"Plastic\", \"quantity\": 2, \"reward\": 2 },\n    { \"product\": \"Metal\", \"quantity\": 1, \"reward\": 1 },\n    { \"product\": \"Tetrapak\", \"quantity\": 0, \"reward\": 0 }\n  ],\n  \"qrPayload\": \"ACO|ACO-TEST-0001-0001|2025-09-16T16:19:02.000Z|3.00|TRY\",\n  \"language\": \"tr\"\n}"
        },
        "url": "{{baseUrl}}/print/receipt"
      }
    },
    {
      "name": "Mock Paper Out",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paper\": \"out\"\n}"
        },
        "url": "{{baseUrl}}/mock/health"
      }
    },
    {
      "name": "Mock Cover Open",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cover\": \"open\"\n}"
        },
        "url": "{{baseUrl}}/mock/health"
      }
    },
    {
      "name": "Mock Overheat",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"temperature\": \"overheat\"\n}"
        },
        "url": "{{baseUrl}}/mock/health"
      }
    },
    {
      "name": "Reset Mock Health",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paper\": \"ok\",\n  \"cover\": \"closed\",\n  \"temperature\": \"normal\"\n}"
        },
        "url": "{{baseUrl}}/mock/health"
      }
    },
    {
      "name": "Simulate Paper Jam",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Paper jam simulation\",\n  \"simulateError\": \"PAPER_JAM\"\n}"
        },
        "url": "{{baseUrl}}/print/text"
      }
    },
    {
      "name": "Simulate Unknown Command",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"Unknown command simulation\",\n  \"simulateError\": \"UNKNOWN_COMMAND\"\n}"
        },
        "url": "{{baseUrl}}/print/text"
      }
    },
    {
      "name": "Simulate Disconnect",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": "{{baseUrl}}/mock/disconnect"
      }
    },
    {
      "name": "Reprint Failed Job",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"jobId\": \"{{failedJobId}}\"\n}"
        },
        "url": "{{baseUrl}}/reprint"
      }
    },
    {
      "name": "Logs",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/logs"
      }
    },
    {
      "name": "Export Logs CSV",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/logs/export"
      }
    }
  ]
}
